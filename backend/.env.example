# ── AI ──────────────────────────────────────────────────────────────────────
# Google Gemini API key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API key — used for Whisper audio transcription
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# ── Confluence ───────────────────────────────────────────────────────────────
# Base URL of your Confluence instance (no trailing slash)
CONFLUENCE_URL=https://your-org.atlassian.net/wiki

# Personal Access Token (or service account token) with page create permissions
CONFLUENCE_TOKEN=your-confluence-pat-here

# Space key where meeting note pages will be created
CONFLUENCE_SPACE_KEY=TEAM

# ── Auth ─────────────────────────────────────────────────────────────────────
# Shared API key checked via X-API-Key header — replace with SSO when ready
ORG_API_KEY=changeme-use-a-long-random-string

# ── Infrastructure ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
DATABASE_URL=sqlite:///./memora.db

# ── Storage ──────────────────────────────────────────────────────────────────
# Local directory for uploaded files (ignored when using S3)
UPLOAD_DIR=uploads

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:80
